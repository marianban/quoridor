{
  "name": "@quoridor/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "quoridor": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run -w @quoridor/core build",
    "prestart": "npm run -w @quoridor/core build",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@quoridor/core": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  }
}
